# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored, so it will never be pushed.

# --- Contact form (required) -------------------------------------------------
# Create a free key at https://resend.com/api-keys
# Without it the form shows an error and asks visitors to email you directly.
RESEND_API_KEY=re_your_key_here

# --- Contact form (optional) -------------------------------------------------
# Where enquiries are delivered.
MAIL_TO=neelamdhiman7590@gmail.com

# The "from" address on those emails.
# onboarding@resend.dev only delivers to your own Resend account address, which
# is all this form needs. Add your own domain in Resend and change this to
# something like "Portfolio <no-reply@yourdomain.com>" to see a proper sender.
MAIL_FROM=Portfolio <onboarding@resend.dev>