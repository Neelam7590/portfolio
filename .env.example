# Resend API Key
# Get it from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Optional: Override where emails are sent (default: neelxm08@gmail.com)
# MAIL_TO=neelxm08@gmail.com

# Optional: Override sender address (default: Portfolio <onboarding@resend.dev>)
# MAIL_FROM="Portfolio <onboarding@resend.dev>"

# Optional: Admin dashboard inbox
# Run tools/schema.sql in Supabase first. Keep the service role key server-side.
# Add these to Vercel for Production AND Preview, then redeploy.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
